# ShopPal v2 — environment template.
# Copy to .env and fill in YOUR OWN sandbox values. Never commit a real .env.
# No real credentials are included here.

# PayPal Sandbox app credentials (from https://developer.paypal.com, Apps & Credentials -> Sandbox).
# Client ID is a public identifier used by the PayPal JS SDK.
PAYPAL_CLIENT_ID=
# Secret is server-only. Never log it, never commit it, never share it.
PAYPAL_CLIENT_SECRET=
# Always "sandbox" for this hackathon. No real money.
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Vyce API (https://vyceai.com/v1) for AI explanations. Server only — never
# commit this key, never log it, never put it in the static demo (docs/).
# The rule-based Risk Score and Total Cost work without it.
VYCE_API_KEY=
VYCE_API_BASE=https://vyceai.com/v1
VYCE_MODEL=deepseek-v4.1

# Real marketplace search — eBay Browse API (free, developer.ebay.com).
# Create a developer account, make an app, copy its App ID + Cert ID here.
# Without these, /api/marketplace/search answers "not configured" and the
# demo falls back to the 10-product catalog. Cert ID is server-only.
EBAY_APP_ID=
EBAY_CERT_ID=
# Optional: override the eBay API base (used by tests with a local mock).
EBAY_API_BASE=https://api.ebay.com
EBAY_MARKETPLACE=EBAY_US

# Local server port.
PORT=3000
