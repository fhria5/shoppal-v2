# ShopPal v2 — environment template.
# Copy to .env and fill in YOUR OWN sandbox values. Never commit a real .env.
# No real credentials are included here.

# PayPal Sandbox app credentials (from https://developer.paypal.com, Apps & Credentials -> Sandbox).
# Client ID is a public identifier used by the PayPal JS SDK.
PAYPAL_CLIENT_ID=
# Secret is server-only. Never log it, never commit it, never share it.
PAYPAL_CLIENT_SECRET=
# Always "sandbox" for this hackathon. No real money.
PAYPAL_MODE=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Gemini API key (free tier) for AI explanations. Optional in the Day 0 skeleton:
# the rule-based Risk Score and Total Cost work without it.
GEMINI_API_KEY=

# Local server port.
PORT=3000
